generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TransactionLog {
  id        String   @id @default(cuid())
  wallet    String
  type      String
  amount    String
  positive  Boolean  @default(true)
  txHash    String?
  createdAt DateTime @default(now())

  @@index([wallet, createdAt(sort: Desc)])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  admin     String
  action    String
  payload   Json?
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

model PlatformStat {
  id        String   @id @default("global")
  tvl       String   @default("0")
  totalStaked String @default("0")
  totalSwapped String @default("0")
  pointsDistributed String @default("0")
  updatedAt DateTime @updatedAt
}
